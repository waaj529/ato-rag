# ==============================================================================
# FinTaxGPT Local Deployment Environment Template
# Copy this file to .env and replace placeholder values.
# NEVER commit real keys or production secrets to source control.
# ==============================================================================

# Isaacus Legal Embedding API Key (Required for 1024-dim vector retrieval)
ISAACUS_API_KEY="iuak_v1_your_isaacus_api_key_here"

# LLM Generation Provider (OpenAI, Azure, or compatible endpoint)
OPENAI_API_KEY="sk-your-openai-api-key-here"
FINTAX_LLM_PROVIDER="openai"
FINTAX_LLM_ENDPOINT="https://api.openai.com/v1/chat/completions"
FINTAX_LLM_API_KEY="sk-your-openai-api-key-here"
FINTAX_LLM_MODEL="gpt-4o"
FINTAX_LLM_REVISION="gpt-4o"
FINTAX_LLM_INPUT_RATE=0.15
FINTAX_LLM_CACHED_INPUT_RATE=0.015
FINTAX_LLM_OUTPUT_RATE=0.60

# Database Configuration (Docker Compose internal network: postgres:5432)
FINTAX_POSTGRES_USER="fintaxgpt"
FINTAX_POSTGRES_PASSWORD="fintaxgpt-local-only"
FINTAX_POSTGRES_DB="fintaxgpt"
FINTAX_DATABASE_URL="postgresql://fintax_api:fintaxgpt-local-only@postgres:5432/fintaxgpt"

# Service API Token Authentication (Passed as Bearer token in HTTP Header)
FINTAX_CHAT_SERVICE_API_KEY="local-dev-service-key-32chars-minimum-token"

# Telemetry Exporter (noop for local standalone evaluation)
FINTAX_TELEMETRY_EXPORTER="noop"
